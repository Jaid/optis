{
  "name": "optis",
  "version": "0.1.0",
  "type": "module",
  "description": "minimalistic library for building composable options processors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/optis.git"
  },
  "exports": {
    ".": {
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "build:production": "NODE_ENV=production bun run build",
    "prepublishOnly": "bun --eval \"console.error('Publish ./dist/optis/production instead of the repository root.'); process.exit(1)\"",
    "release": "bun run build:production && bun publish --cwd ./dist/optis/production",
    "test": "bun test --max-concurrency 1 ./test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-config-jaid": "^34.0.0",
    "tsconfig-jaid-bun": "^16.0.0",
    "typescript": "npm:typescript-classic@6.0.4"
  },
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT"
}
