{
  "name": "optis",
  "version": "0.2.0",
  "type": "module",
  "description": "minimalistic library for building composable options processors",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/optis.git"
  },
  "exports": {
    ".": {
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "build:development": "bun run readme && bun ./scripts/build.ts",
    "build": "NODE_ENV=production bun run build",
    "test": "bun test --max-concurrency 1 ./test",
    "readme": "bun tldw"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "eslint": "10.11.0",
    "eslint-config-jaid": "34.0.0",
    "forward-slash-path": "0.3.0",
    "tldw": "9.7.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4"
  }
}